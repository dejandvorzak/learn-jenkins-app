{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "LearnJenkinsApp-TaskDefinition-Prod-Dejan",
    "containerDefinitions": [
        {
            "name": "learnjenkinsapp",
            "image": "313092059017.dkr.ecr.us-east-1.amazonaws.com/learnjenkinsapp:1.2.80",
            "portMappings": [{
                "name": "ngnix-80-tip",
                "containerPort": 80,
                "hostPort": 80,
                "protocol": "tcp",
                "appProtocol": "http"
            }],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512",
    "cpu": "256",
    "executionRoleArn": "arn:aws:iam::313092059017:role/ecsTaskExecutionRole"
}